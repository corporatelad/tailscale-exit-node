# Required — generate a reusable auth key at https://login.tailscale.com/admin/settings/keys
# Use a reusable key so the node can re-authenticate after Railway restarts.
# Tag it (e.g. tag:exit-node) and enable "Reusable" + "Pre-authorized" to skip manual approval.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — how this node appears in your tailnet (default: railway-exit-node)
TS_HOSTNAME=railway-exit-node

# Optional — any extra flags to pass to `tailscale up`
# e.g. --advertise-tags=tag:exit-node
TS_EXTRA_ARGS=
